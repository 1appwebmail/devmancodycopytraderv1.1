# --- Yellowstone gRPC sources (dedup'd by signature across however many are configured — first
# event wins, the rest are ignored as duplicates. Any subset can be left blank.) ---
PUBLICNODE_GRPC_ENDPOINT=https://solana-yellowstone-grpc.publicnode.com:443
PUBLICNODE_GRPC_TOKEN=

HELIUS_GRPC_ENDPOINT=
HELIUS_API_KEY=

# rpcfast's standard Yellowstone gRPC (NOT Aperture TxStream — that's a different, non-Yellowstone
# protocol that omits inner instructions/program logs, which this bot's trade decoder depends on).
RPCFAST_GRPC_ENDPOINT=
RPCFAST_GRPC_TOKEN=

# Raiden Vortex (raiden.wtf) — Geyser/Yellowstone-compatible, so it's a pure config addition, no
# code changes (verified: the client library auto-detects http:// vs https:// and picks
# TLS/insecure credentials accordingly). Two things that differ from every other source above:
#   1. Endpoints are plain http://, not https:// — e.g. http://fra.vortex.raiden.wtf:10001/
#      (per-region: fra/ams/nyc/lnd). This is correct and expected for Vortex, not a typo.
#   2. Auth is IP-WHITELIST based, not token based — you register your machine's IP on Raiden's
#      dashboard and connections from it are accepted with no token at all. RAIDEN_GRPC_TOKEN is
#      only here for forward-compatibility if that ever changes; leave it blank for now. If you
#      ever run this bot from a different machine (see RUNNING.md), remember its IP needs
#      registering too, or the connection will be rejected regardless of anything in this file.
RAIDEN_GRPC_ENDPOINT=
RAIDEN_GRPC_TOKEN=

# Subscribes to ALL pump.fun program activity (not just target wallets) to pre-warm the mcap/age
# caches from every token creation platform-wide, not just ones your target wallets happen to
# create themselves — cuts a ~0.5-1s cold RPC lookup out of most live copy-trade decisions. Costs
# meaningfully more gRPC message volume in exchange (every pump.fun trade arrives here too, not
# just creates — non-target trades are silently dropped downstream, not wasted work beyond the
# extra bandwidth/decode). Set to false if that volume becomes a problem.
ENABLE_CREATE_PREWARM=true

# Plain HTTPS RPC, used for one-off account/tx lookups (not the live feed) — pricing fills, mcap/
# age filter resolution, position monitoring. The public endpoint is rate-limited hard enough that
# it can make filters look "broken" (a 429 makes mcap/age resolve to null, and the filters
# deliberately skip a trade rather than silently ignore an unresolved bound — see App.resolveTradeContext).
# There's retry-with-backoff on every RPC call now, but a paid endpoint (you already have a Helius
# key for the gRPC feed — its RPC endpoint works here too) is far more reliable than the public one.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com

# --- Strategy ---
# Comma-separated wallet addresses to copy
TARGET_WALLETS=62qEWURTpb8RNqoPCrjaoRcfU4PneigVKbiuGtin2Wb4,4hSXPtxZgXFpo6Vxq9yqxNjcBoqWN3VoaPJWonUtupzD,CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o,4BdKaxN8G6ka4GYtQQWk4G4dZRUTX2vQH9GcXdBREFUk,AQdBYZNy3BZ1vouGUjA1w9Ay7aq7kH5UQSuh4LQWKotY,2qW5LsgAGnCnyfVvzhwBQBfLsQ6hz3o2uaB29U3CSHBy,9yYya3F5EJoLnBNKW6z4bZvyQytMXzDcpU5D6yYr4jqL

MODE=paper
# --- Live mode (MODE=live) — real transactions, real SOL. Leave MODE=paper until you've run
# `npm run live:dry-run <mint>` successfully and are ready to test with real funds.
#
# Trading wallet's secret key — base58 string (what Phantom/Solflare export) OR a JSON array of 64

# numbers (what `solana-keygen` writes). NEVER commit this file with a real key in it.
LIVE_PRIVATE_KEY=
# Optional: if set, startup verifies LIVE_PRIVATE_KEY actually derives to this address, so a
# pasted-wrong key fails loudly instead of silently trading from an unexpected wallet.
LIVE_WALLET_ADDRESS=

# Hard safety caps, enforced in code before any transaction is built (independent of
# POSITION_SIZE_SOL/MAX_CONCURRENT_POSITIONS above — this is the last line of defense).
LIVE_MAX_POSITION_SOL=0.05
LIVE_MAX_TOTAL_SOL_AT_RISK=0.2
LIVE_MIN_SOL_RESERVE=0.02
# How far below the current-reserves estimate to set the exact-output ask on a buy (or exact-input

# on a sell) — protects against a fill failing purely because price moved slightly between
# submission and landing. 500 = 5%.
LIVE_SLIPPAGE_BPS=500
LIVE_COMPUTE_UNIT_LIMIT=300000
LIVE_COMPUTE_UNIT_PRICE_MICROLAMPORTS=50000
LIVE_CONFIRM_TIMEOUT_MS=45000

# rpcfast Beam (Jito/SWQoS) — optional. Leave blank to submit via plain RPC_HTTP_URL instead.
# Get your own API key/URL from rpcfast's dashboard — never commit a real key here.
BEAM_HTTP_URL=
# Optional — only needed if your dashboard-issued BEAM_HTTP_URL does NOT already embed the key as
# a `?api_key=` query param. submit.ts sends whichever of the two it finds as an X-Token header
# (rpcfast's public docs describe X-Token auth; this project's dashboard-issued URL used a query
# param instead — both are sent since which one Beam actually checks wasn't fully verifiable from
# public docs alone).
BEAM_API_KEY=
# One of: astralane, bloxroute, nozomi, falcon. Must match whichever provider's tip accounts you
# put in LIVE_BEAM_TIP_ACCOUNTS below — each provider has its OWN distinct tip account list, mixing
# them will likely be rejected or silently misroute. Confirm the current list for your chosen
# provider from your rpcfast dashboard/support (not hardcoded here — can change).
BEAM_PROVIDER=
LIVE_BEAM_TIP_ACCOUNTS=
# rpcfast's docs specify a 0.001 SOL (1,000,000 lamport) minimum tip — default is set a bit above
# that as a safety margin.
LIVE_BEAM_TIP_LAMPORTS=1200000

# STARTING_PAPER_BALANCE_SOL only applies in MODE=paper. POSITION_SIZE_SOL and
# MAX_CONCURRENT_POSITIONS apply in BOTH modes — in MODE=live, POSITION_SIZE_SOL is the real SOL
# spent per buy (checked against LIVE_MAX_POSITION_SOL above at startup) and MAX_CONCURRENT_POSITIONS
# caps real open positions, not just paper ones. Kept at 0.05 here to match the LIVE_MAX_POSITION_SOL
# example above so MODE=live doesn't immediately fail its own safety check with these defaults.
STARTING_PAPER_BALANCE_SOL=10
POSITION_SIZE_SOL=0.05
MAX_CONCURRENT_POSITIONS=5
# Flat approximate protocol fee used for constant-product fill estimates — both PaperExecutor's
# simulated fills AND LiveExecutor's pre-trade slippage/amount estimate (the REAL fee is enforced
# on-chain regardless; this only affects the estimate used to decide how much to ask for). 100 = 1%.
PAPER_FEE_BPS=100

STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=100
TRAILING_STOP_PCT=15
COPY_SELL=true
MAX_HOLD_SECONDS=0
POSITION_POLL_INTERVAL_MS=5000

# Ladder take-profit (optional — leave blank to keep the old single-shot TAKE_PROFIT_PCT behavior).
# Format: "pct:fractionPct,pct:fractionPct,..." — sell that % of the ORIGINAL position size each
# time price crosses that % profit from entry. Whatever's left keeps riding the trailing
# stop/stop-loss/time-limit rules above (and TAKE_PROFIT_PCT, if set, still acts as a final
# full-exit ceiling on whatever remains past the last tier).
# Example: sell 25% at +50%, another 25% at +100%, another 25% at +200%, let the rest trail:
# LADDER_TP=50:25,100:25,200:25
LADDER_TP=

# --- Entry filters (also editable live from the UI's Save Filters button — these are just the
# startup defaults, so a restart doesn't reset them back to "no limit"). Leave blank for no limit.
MIN_MCAP_USD=
MAX_MCAP_USD=
MIN_AGE_SECONDS=
MAX_AGE_SECONDS=
# Filters out tiny "chart support" buys (e.g. a target wallet buying 0.001 SOL just to bump the
# chart) and optionally caps how large a target buy you're willing to follow.
MIN_TARGET_BUY_SOL=
MAX_TARGET_BUY_SOL=

# --- Reporting ---
TELEGRAM_BOT_TOKEN=
# Comma-separated for multiple recipients (a personal chat ID, a group ID, or a mix). Each person
# must have already messaged the bot at least once (even just /start) — Telegram bots can't
# initiate a DM. For a group, add the bot to the group first, then use the group's chat ID.
TELEGRAM_CHAT_ID=

# --- Frontend/API server ---
API_PORT=4000
BOT_NAME=Devmancody-CopytraderBot
